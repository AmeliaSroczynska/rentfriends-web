---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';
import { heroImage, heroWidths, heroSizes, heroFormat } from '../data/heroImage';
import { satisfiedUsers, appRatingDisplay } from '../data/stats';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEn = lang === 'en';

const softwareSchema = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "RentFriends",
    "operatingSystem": "iOS, Android",
    "applicationCategory": "LifestyleApplication",
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": appRatingDisplay,
        "ratingCount": "3000"
    },
    "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "PLN"
    }
};
---

<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

<section class="relative w-full overflow-hidden bg-bg dark:bg-black transition-colors duration-300 pt-8 pb-10 lg:pt-12 lg:pb-[20px]">
    <div class="glow-purple absolute top-0 left-0 w-[920px] h-[920px] lg:w-[1440px] lg:h-[1440px] opacity-15 dark:hidden rounded-full pointer-events-none -translate-x-1/2 -translate-y-1/2 z-0"></div>

    <div class="max-w-[1440px] mx-auto px-6 lg:px-[100px] relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between lg:gap-8 xl:gap-16">

        <div class="absolute left-1/2 -translate-x-1/2 w-[100vw] h-[1px] bg-gray/30 bottom-0 lg:-bottom-[20px] pointer-events-none -z-10"></div>

        <div class="w-full lg:flex-1 lg:max-w-[672px] flex flex-col relative z-20 lg:pb-12">

            <h1 class="text-black dark:text-bg font-sans font-[800] text-[40px] min-[500px]:text-[44px] min-[700px]:text-[48px] md:text-[48px] lg:text-[64px] xl:text-[72px] leading-[1.05] md:leading-[1.1] lg:leading-[67.2px] xl:leading-[75.6px] tracking-[-1.5px] lg:tracking-[-1.92px] xl:tracking-[-2.16px] mb-4 sm:mb-6 transition-colors max-w-[90vw] lg:max-w-none z-20 relative">
                <span set:html={t('hero.title.part1')}></span>
                <br />
                <span class="bg-[linear-gradient(100deg,#234CE0_6.17%,#A247E3_50%,#E95BD2_93.83%)] bg-clip-text text-transparent inline-block pb-2 sm:pb-4" set:html={t('hero.title.part2')}></span>
            </h1>

            <div class="w-full max-w-[560px] lg:max-w-none flex flex-col z-10 relative">

                <p class="text-gray dark:text-bg/80 font-sans text-[17px] lg:text-[18px] font-[400] leading-[1.6] mb-7 lg:mb-8 transition-colors">
                    {t('hero.description')}
                </p>

                <div class="flex flex-col sm:flex-row lg:flex-col xl:flex-row items-stretch gap-3 lg:gap-5 mb-6 lg:mb-8 w-full">
                    <a href={isEn ? '/en/tenants' : '/tenants'}
                       class="flex items-center justify-center whitespace-nowrap rounded-full border-[1.5px] border-transparent bg-[image:var(--background-image-gradient)] min-h-[52px] px-7 lg:px-6 py-3.5 font-sans text-[17px] lg:text-[16px] font-bold text-bg transition-all duration-300 ease-out hover:opacity-90 hover:scale-[1.02] active:scale-95">
                        {t('hero.cta.tenant')}
                    </a>
                    <a href={isEn ? '/en/landlords' : '/landlords'}
                       class="flex items-center justify-center whitespace-nowrap rounded-full border-[1.5px] border-black/22 dark:border-white/25 min-h-[52px] px-7 lg:px-6 py-3.5 font-sans text-[17px] lg:text-[16px] font-semibold text-black dark:text-bg transition-all duration-300 ease-out hover:border-black/40 dark:hover:border-white/40 hover:scale-[1.02] active:scale-95">
                        {t('hero.cta.landlord')}
                    </a>
                </div>

                <div class="flex flex-row flex-wrap items-center gap-3 lg:gap-5 mb-7 lg:mb-8 w-full">

                    <a href="https://play.google.com/store/apps/details?id=app.dyzury&pcampaignid=web_share" target="_blank" rel="noopener noreferrer"
                       class="flex items-center justify-center shrink-0 bg-black dark:bg-white/5 text-white border border-transparent dark:border-white/20 hover:opacity-90 hover:scale-[1.02] transition-all cursor-pointer w-[170px] lg:w-[175px] h-[56px] lg:h-[58px] px-3 rounded-[12px] gap-2.5">
                        <svg class="h-auto flex-shrink-0 w-[26px]" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M2.373 1.306C2.128 1.564 2 1.954 2 2.454v19.09c0 .5.128.89.373 1.148l.056.054 10.74-10.74v-.004L2.43 1.252l-.057.054z" fill="#4285F4"/>
                            <path d="M17.435 15.656l-4.266-4.266v-.004L2.43 1.252A1.666 1.666 0 0 1 3.5.75c.427 0 .85.148 1.228.406l12.707 7.228z" fill="#34A853"/>
                            <path d="M17.435 8.344l-4.266 4.266.002.002L2.43 23.35c.378.258.801.406 1.228.406a1.67 1.67 0 0 0 1.07-.502l12.707-7.228z" fill="#EA4335"/>
                            <path d="M17.435 15.656L22.65 12.7c1.135-.646 1.135-1.7 0-2.346l-5.215-2.956-4.266 4.266 4.266 4.266z" fill="#FBBC04"/>
                        </svg>
                        <div class="text-left flex flex-col justify-center overflow-hidden">
                            <span class="block font-medium tracking-wide text-white/90 leading-tight text-[11px] whitespace-nowrap">{t('hero.download.google')}</span>
                            <span class="block font-semibold tracking-tight leading-[1.15] text-[20px] whitespace-nowrap" style="font-family: 'Product Sans', sans-serif;">Google Play</span>
                        </div>
                    </a>

                    <a href="https://apps.apple.com/gr/app/rentfriends-rent-rooms/id6502833411" target="_blank" rel="noopener noreferrer"
                       class="flex items-center justify-center shrink-0 bg-black dark:bg-white/5 text-white border border-transparent dark:border-white/20 hover:opacity-90 hover:scale-[1.02] transition-all cursor-pointer w-[170px] lg:w-[175px] h-[56px] lg:h-[58px] px-3 rounded-[12px] gap-2.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-auto flex-shrink-0 w-[22px]" viewBox="0 0 14 17" fill="none">
                            <path d="M12.3713 14.5833C11.6797 15.6167 10.9463 16.625 9.82966 16.6417C8.71299 16.6667 8.35466 15.9833 7.08799 15.9833C5.81299 15.9833 5.42133 16.625 4.36299 16.6667C3.27133 16.7083 2.44633 15.5667 1.74633 14.5583C0.321325 12.5 -0.770342 8.70833 0.696325 6.15833C1.42132 4.89167 2.72132 4.09167 4.12966 4.06667C5.19632 4.05 6.21299 4.79167 6.87133 4.79167C7.52133 4.79167 8.75466 3.9 10.038 4.03333C10.5797 4.05833 12.0963 4.25 13.0713 5.68333C12.9963 5.73333 11.263 6.75 11.2797 8.85833C11.3047 11.375 13.488 12.2167 13.513 12.225C13.488 12.2833 13.163 13.425 12.363 14.5833M7.61299 1.25C8.22132 0.558333 9.22966 0.0333333 10.063 0C10.1713 0.975 9.77966 1.95833 9.19633 2.65833C8.62132 3.36667 7.67133 3.91667 6.73799 3.84167C6.61299 2.88333 7.07966 1.88333 7.61299 1.25Z" fill="white"/>
                        </svg>
                        <div class="text-left flex flex-col justify-center overflow-hidden">
                            <span class="block font-medium tracking-wide text-white/90 leading-tight text-[11px] whitespace-nowrap">{t('hero.download.apple')}</span>
                            <span class="block font-semibold tracking-tight leading-[1.15] text-[21px] whitespace-nowrap">App Store</span>
                        </div>
                    </a>
                </div>

                <div class="flex flex-row flex-wrap items-center gap-x-6 gap-y-2 xl:gap-x-8 text-[16px] font-normal text-gray dark:text-bg/80 transition-colors">
                    <span class="whitespace-nowrap"><strong class="font-bold text-black dark:text-bg text-[22px] mr-1.5 sm:mr-2">{satisfiedUsers}+</strong>{t('hero.stats.users')}</span>
                    <span class="whitespace-nowrap"><strong class="font-bold text-black dark:text-bg text-[22px] mr-1.5 sm:mr-2">{appRatingDisplay}★</strong>{t('hero.stats.rating')}</span>
                    <span class="whitespace-nowrap"><strong class="font-bold text-black dark:text-bg text-[22px] mr-1.5 sm:mr-2">{t('hero.stats.free')}</strong>{t('hero.stats.app')}</span>
                </div>
            </div>
        </div>

        <div class="hidden relative lg:right-0 lg:-bottom-[20px] lg:flex lg:justify-end lg:items-end lg:self-end lg:flex-1 lg:max-w-[472px] pointer-events-none select-none z-10 w-auto">
            <Image
                    src={heroImage}
                    format={heroFormat}
                    alt={t('hero.alt.phone') || 'Aplikacja RentFriends'}
                    widths={heroWidths}
                    sizes={heroSizes}
                    loading="eager"
                    fetchpriority="high"
                    decoding="sync"
                    class="w-[64vw] max-w-[300px] sm:w-[340px] sm:max-w-none lg:w-full h-auto object-contain object-right-bottom origin-bottom-right"
            />
        </div>

    </div>
</section>