                        <span class="block text-[21px] font-semibold -mt-1 tracking-tight" style="font-family: 'Product Sans', sans-serif;">Google Play</span>
                    </div>
                </a>

                <a href="https://apps.apple.com/gr/app/rentfriends-rent-rooms/id6502833411" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 bg-black text-white px-5 py-2.5 rounded-[12px] border border-white/20 hover:opacity-90 hover:scale-[1.02] transition-all cursor-pointer h-[60px] min-w-[190px]">
