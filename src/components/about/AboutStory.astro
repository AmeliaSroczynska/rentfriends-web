---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="story" class="w-full scroll-mt-[72px] bg-bg dark:bg-black transition-colors duration-300 pt-10 pb-16 sm:pt-14 sm:pb-20 lg:pt-[70px] lg:pb-[110px] px-6 lg:px-[100px]">
    <div class="mx-auto max-w-[1208px]">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)] gap-8 lg:gap-[70px]">

            <div class="lg:sticky lg:top-[100px] lg:self-start">
                <h2 class="font-sans font-[800] text-[28px] sm:text-[34px] lg:text-[40px] leading-[1.16] tracking-[-1px] text-black dark:text-bg transition-colors">
                    {t('about.story.title')}
                </h2>
                <span aria-hidden="true" class="mt-6 block h-[3px] w-[90px] rounded-full bg-[image:var(--background-image-gradient)]"></span>
            </div>

            <p class="font-sans font-normal text-[16px] sm:text-[17px] lg:text-[19px] leading-[1.75] text-gray dark:text-bg/75 transition-colors">
                {t('about.story.text')}
            </p>
        </div>
    </div>
</section>
