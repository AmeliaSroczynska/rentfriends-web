---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="security" class="w-full scroll-mt-[72px] bg-bg dark:bg-black transition-colors duration-300 pb-16 sm:pb-20 lg:pb-[110px] px-6 lg:px-[100px]">
    <div class="mx-auto max-w-[1208px]">
        <div class="relative overflow-hidden rounded-[32px] bg-[image:var(--background-image-gradient)] px-7 py-10 sm:px-12 sm:py-12 lg:px-[70px] lg:py-[68px] text-white shadow-xl">

            <span aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 size-[320px] rounded-full bg-white/10"></span>
            <span aria-hidden="true" class="pointer-events-none absolute -right-10 top-20 size-[200px] rounded-full border border-white/20"></span>

            <div class="relative z-10 max-w-[760px]">
                <span class="flex size-[62px] items-center justify-center rounded-[20px] bg-white/15 border border-white/25 backdrop-blur-md" aria-hidden="true">
                    <svg class="size-[28px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3.2 19.4 6v5.4c0 4.4-3 8-7.4 9.4-4.4-1.4-7.4-5-7.4-9.4V6z" />
                        <path d="m9 12.1 2.1 2.1 3.9-4.1" />
                    </svg>
                </span>

                <h2 class="font-sans font-[800] text-[27px] sm:text-[34px] lg:text-[40px] leading-[1.16] tracking-[-1px]">
                    {t('about.security.title')}
                </h2>
                <p class="mt-4 font-sans font-normal text-[15px] sm:text-[16px] lg:text-[17px] leading-[1.72] text-white/90">
                    {t('about.security.text')}
                </p>
            </div>
        </div>
    </div>
</section>
