---
import { Picture } from 'astro:assets';
import feature1Img from '../../assets/features1.png';
import feature2Img from '../../assets/features2.png';
import feature3Img from '../../assets/features3.png';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tags = [
    t('landlords.alt.s1.t1'), t('landlords.alt.s1.t2'), t('landlords.alt.s1.t3'),
    t('landlords.alt.s1.t4'), t('landlords.alt.s1.t5'), t('landlords.alt.s1.t6'),
    t('landlords.alt.s1.t7'), t('landlords.alt.s1.t8'), t('landlords.alt.s1.t9'),
    t('landlords.alt.s1.t10'), t('landlords.alt.s1.t11'),
];
---

<section id="features" class="w-full scroll-mt-[72px] bg-bg dark:bg-black transition-colors duration-300 py-16 sm:py-20 lg:py-[100px] px-6 lg:px-[100px]">
    <div class="mx-auto max-w-[1208px]">

        <h2 class="font-sans font-[800] text-[28px] sm:text-[34px] lg:text-[40px] leading-[1.18] tracking-[-0.8px] lg:tracking-[-1.1px] text-black dark:text-bg transition-colors">
            {t('landlords.alt.title1')}
            <br />
            <span class="bg-[linear-gradient(to_right,var(--color-blue),var(--color-purple),var(--color-pink))] bg-clip-text text-transparent">
                {t('landlords.alt.title2')}
            </span>
        </h2>

        <div class="mt-10 lg:mt-14 flex flex-col gap-6 lg:gap-[60px]">

            <article class="w-full lg:max-w-[1020px] lg:self-end rounded-[32px] bg-purple/11 px-7 py-7 sm:px-9 sm:py-8 lg:px-[42px] lg:py-[26px] transition-colors">
                <div class="flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-10">

                    <div class="min-w-0 lg:flex-1">
                        <div class="flex items-center gap-4">
                            <span aria-hidden="true" class="flex size-[42px] lg:size-[46px] shrink-0 items-center justify-center rounded-full border-2 border-purple font-sans text-[20px] lg:text-[23px] font-[800] tracking-[-1px] text-purple">1</span>
                            <h3 class="font-sans font-[800] text-[20px] lg:text-[24px] leading-[1.2] tracking-[-0.8px] text-black dark:text-bg transition-colors">
                                {t('landlords.alt.s1.title')}
                            </h3>
                        </div>

                        <p class="mt-3 max-w-[560px] font-sans text-[14.5px] lg:text-[15.5px] leading-[1.65] text-gray dark:text-bg/70 transition-colors">
                            {t('landlords.alt.s1.text')}
                        </p>

                        <div class="mt-3.5 flex flex-wrap gap-1.5">
                            {tags.map((tag) => (
                                <span class="rounded-full border border-black/10 dark:border-white/15 bg-bg dark:bg-white/5 px-3 py-[7px] font-sans text-[12.5px] font-medium text-black dark:text-bg transition-colors">
                                    {tag}
                                </span>
                            ))}
                        </div>

                        <p class="mt-4 max-w-[520px] rounded-[16px] bg-bg dark:bg-white/5 px-4 py-2.5 font-sans text-[13.5px] lg:text-[14.5px] font-semibold leading-[1.6] text-black dark:text-bg transition-colors">
                            {t('landlords.alt.s1.note')}
                        </p>
                    </div>

                    <div class="relative z-10 shrink-0 self-center lg:-my-[26px] lg:-mr-[86px] xl:-mr-[100px]">
                        <Picture src={feature1Img} widths={[150, 190, 380]} sizes="(min-width: 1024px) 190px, 150px" formats={['avif']} fallbackFormat="webp" loading="lazy" decoding="async" alt={t('landlords.alt.s1.img')} pictureAttributes={{ class: 'contents' }} class="w-[150px] lg:w-[190px] h-auto rotate-[5deg] drop-shadow-[0_26px_52px_rgba(9,20,50,0.22)]" />
                    </div>
                </div>
            </article>

            <article class="w-full lg:max-w-[1020px] lg:self-start rounded-[32px] bg-purple/11 px-7 py-7 sm:px-9 sm:py-8 lg:px-[42px] lg:py-[26px] transition-colors">
                <div class="flex flex-col lg:flex-row-reverse lg:items-center gap-8 lg:gap-10">

                    <div class="min-w-0 lg:flex-1">
                        <div class="flex items-center gap-4">
                            <span aria-hidden="true" class="flex size-[42px] lg:size-[46px] shrink-0 items-center justify-center rounded-full border-2 border-purple font-sans text-[20px] lg:text-[23px] font-[800] tracking-[-1px] text-purple">2</span>
                            <h3 class="font-sans font-[800] text-[20px] lg:text-[24px] leading-[1.2] tracking-[-0.8px] text-black dark:text-bg transition-colors">
                                {t('landlords.alt.s2.title')}
                            </h3>
                        </div>

                        <p class="mt-3 max-w-[560px] font-sans text-[14.5px] lg:text-[15.5px] leading-[1.65] text-gray dark:text-bg/70 transition-colors">
                            {t('landlords.alt.s2.text1')}
                        </p>
                        <p class="mt-2 max-w-[560px] font-sans text-[14.5px] lg:text-[15.5px] leading-[1.65] text-gray dark:text-bg/70 transition-colors">
                            {t('landlords.alt.s2.text2')}
                        </p>

                        <p class="mt-4 max-w-[520px] rounded-[16px] bg-bg dark:bg-white/5 px-4 py-2.5 font-sans text-[13.5px] lg:text-[14.5px] font-semibold leading-[1.6] text-black dark:text-bg transition-colors">
                            {t('landlords.alt.s2.note')}
                        </p>
                    </div>

                    <div class="relative z-10 shrink-0 self-center lg:-my-[26px] lg:-ml-[86px] xl:-ml-[100px]">
                        <Picture src={feature2Img} widths={[150, 190, 380]} sizes="(min-width: 1024px) 190px, 150px" formats={['avif']} fallbackFormat="webp" loading="lazy" decoding="async" alt={t('landlords.alt.s2.img')} pictureAttributes={{ class: 'contents' }} class="w-[150px] lg:w-[190px] h-auto -rotate-[5deg] drop-shadow-[0_26px_52px_rgba(9,20,50,0.22)]" />
                    </div>
                </div>
            </article>

            <article class="w-full lg:max-w-[1020px] lg:self-end rounded-[32px] bg-purple/11 px-7 py-7 sm:px-9 sm:py-8 lg:px-[42px] lg:py-[26px] transition-colors">
                <div class="flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-10">

                    <div class="min-w-0 lg:flex-1">
                        <div class="flex items-center gap-4">
                            <span aria-hidden="true" class="flex size-[42px] lg:size-[46px] shrink-0 items-center justify-center rounded-full border-2 border-purple font-sans text-[20px] lg:text-[23px] font-[800] tracking-[-1px] text-purple">3</span>
                            <h3 class="max-w-[420px] font-sans font-[800] text-[20px] lg:text-[24px] leading-[1.2] tracking-[-0.8px] text-black dark:text-bg transition-colors">
                                {t('landlords.alt.s3.title')}
                            </h3>
                        </div>

                        <p class="mt-3 max-w-[560px] font-sans text-[14.5px] lg:text-[15.5px] leading-[1.65] text-gray dark:text-bg/70 transition-colors">
                            {t('landlords.alt.s3.text1')}
                        </p>
                        <p class="mt-2 max-w-[560px] font-sans text-[14.5px] lg:text-[15.5px] leading-[1.65] text-gray dark:text-bg/70 transition-colors">
                            {t('landlords.alt.s3.text2')}
                        </p>
                        <p class="mt-2 max-w-[560px] font-sans text-[14.5px] lg:text-[15.5px] leading-[1.65] text-gray dark:text-bg/70 transition-colors">
                            {t('landlords.alt.s3.text3')}
                        </p>
                    </div>

                    <div class="relative z-10 shrink-0 self-center lg:-my-[26px] lg:-mr-[86px] xl:-mr-[100px]">
                        <Picture src={feature3Img} widths={[150, 190, 380]} sizes="(min-width: 1024px) 190px, 150px" formats={['avif']} fallbackFormat="webp" loading="lazy" decoding="async" alt={t('landlords.alt.s3.img')} pictureAttributes={{ class: 'contents' }} class="w-[150px] lg:w-[190px] h-auto rotate-[5deg] drop-shadow-[0_26px_52px_rgba(9,20,50,0.22)]" />
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>
