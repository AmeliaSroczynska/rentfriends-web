---
import { Picture } from 'astro:assets';
import feature1Img from '../../assets/features1.png';
import feature2Img from '../../assets/features2.png';
import feature3Img from '../../assets/features3.png';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = [
    { title: t('landlords.alt.s1.title'), image: feature1Img, alt: t('landlords.alt.s1.img') },
    { title: t('landlords.alt.s2.title'), image: feature2Img, alt: t('landlords.alt.s2.img') },
    { title: t('landlords.alt.s3.title'), image: feature3Img, alt: t('landlords.alt.s3.img') },
    { title: t('landlords.alt.s4.title'), image: null, alt: '' },
];
---

<section id="features" class="w-full scroll-mt-[72px] bg-bg dark:bg-black transition-colors duration-300 py-16 sm:py-20 lg:py-[100px] px-6 lg:px-[100px]">
    <div class="mx-auto max-w-[1208px]">

        <h2 class="font-sans font-[800] text-[28px] sm:text-[34px] lg:text-[40px] leading-[1.18] tracking-[-0.8px] lg:tracking-[-1.1px]">
            <span class="bg-[linear-gradient(to_right,var(--color-blue),var(--color-purple),var(--color-pink))] bg-clip-text text-transparent">
                {t('landlords.alt.title')}
            </span>
        </h2>

        <div class="mt-10 lg:mt-14 flex flex-col gap-6 lg:gap-[60px]">
            {items.map((item, i) => (
                <article class:list={[
                    'w-full lg:max-w-[1020px] lg:h-[190px] rounded-[32px] bg-purple/11 px-6 py-7 sm:px-9 sm:py-8 lg:px-[42px] lg:py-0 transition-colors',
                    i % 2 === 0 ? 'lg:self-end' : 'lg:self-start',
                ]}>
                    <div class:list={[
                        'flex h-full flex-col lg:items-center gap-8 lg:gap-10',
                        i % 2 === 0 ? 'lg:flex-row' : 'lg:flex-row-reverse',
                    ]}>
                        <div class="flex min-w-0 lg:flex-1 items-center gap-4">
                            <span aria-hidden="true" class="flex size-[42px] lg:size-[46px] shrink-0 items-center justify-center rounded-full border-2 border-purple font-sans text-[20px] lg:text-[23px] font-[800] tracking-[-1px] text-purple">{i + 1}</span>
                            <h3 class="max-w-[560px] font-sans font-normal text-[18px] lg:text-[25px] leading-[1.32] tracking-[-0.3px] text-black dark:text-bg transition-colors">
                                {item.title}
                            </h3>
                        </div>

                        {item.image && (
                            <div class:list={[
                                'relative z-10 shrink-0 self-center',
                                i % 2 === 0 ? 'lg:-mr-[66px] xl:-mr-[80px]' : 'lg:-ml-[66px] xl:-ml-[80px]',
                            ]}>
                                <Picture
                                    src={item.image}
                                    widths={[130, 150, 300]}
                                    sizes="(min-width: 1024px) 150px, 130px"
                                    formats={['avif']}
                                    fallbackFormat="webp"
                                    loading="lazy"
                                    decoding="async"
                                    alt={item.alt}
                                    pictureAttributes={{ class: 'contents' }}
                                    class:list={[
                                        'w-[130px] lg:w-[150px] h-auto drop-shadow-[0_22px_44px_rgba(9,20,50,0.22)]',
                                        i % 2 === 0 ? 'rotate-[5deg]' : '-rotate-[5deg]',
                                    ]}
                                />
                            </div>
                        )}
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>
