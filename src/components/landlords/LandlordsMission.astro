---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="mission" class="w-full scroll-mt-[72px] bg-bg dark:bg-black transition-colors duration-300 pt-10 pb-16 sm:pb-20 lg:pb-[110px] px-6 lg:px-[100px]">
    <div class="mx-auto max-w-[1240px] flex flex-col items-center text-center">

        <p class="flex items-center gap-2 rounded-full bg-purple/13 px-3 py-1.5 font-sans text-[12px] font-bold text-purple transition-colors">
            <span aria-hidden="true" class="size-[5px] shrink-0 rounded-full bg-purple"></span>
            {t('landlords.mission.badge')}
        </p>

        <h2 class="mt-7 max-w-[1084px] font-sans font-[800] text-[26px] sm:text-[32px] lg:text-[40px] leading-[1.3] tracking-[-0.6px] lg:tracking-[-0.9px] text-black dark:text-bg transition-colors">
            {t('landlords.mission.title1')}
        </h2>

        <p class="max-w-[960px] font-sans font-[800] text-[26px] sm:text-[32px] lg:text-[40px] leading-[1.3] tracking-[-0.6px] lg:tracking-[-0.9px] bg-[linear-gradient(to_right,var(--color-blue),var(--color-pink))] bg-clip-text text-transparent">
            {t('landlords.mission.title2')}
        </p>

        <p class="mt-5 max-w-[786px] font-sans text-[16px] sm:text-[18px] lg:text-[20px] leading-[1.68] text-gray dark:text-bg/70 transition-colors">
            {t('landlords.mission.text')}
        </p>
    </div>
</section>
