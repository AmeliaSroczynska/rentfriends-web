---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const rows = [
    { label: t('landlords.compare.f1'), other: true },
    { label: t('landlords.compare.f2'), other: false },
    { label: t('landlords.compare.f3'), other: false },
    { label: t('landlords.compare.f4'), other: false },
    { label: t('landlords.compare.f5'), other: false },
    { label: t('landlords.compare.f6'), other: false },
];
---

<section id="comparison" class="w-full scroll-mt-[72px] bg-bg dark:bg-black transition-colors duration-300 pt-10 lg:pt-[60px] pb-16 sm:pb-20 lg:pb-[110px] px-6 lg:px-[100px]">
    <div class="mx-auto max-w-[1208px]">

        <h2 class="text-center font-sans font-[800] text-[24px] sm:text-[30px] lg:text-[36px] tracking-[-0.7px] lg:tracking-[-1px] text-black dark:text-bg transition-colors">
            {t('landlords.compare.title')}
        </h2>
        <p class="mt-2.5 text-center font-sans text-[15px] lg:text-[17px] text-gray dark:text-bg/70 transition-colors">
            {t('landlords.compare.subtitle')}
        </p>

        <div class="mt-9 lg:mt-11 relative grid grid-cols-[1fr_auto_auto] sm:grid-cols-[1fr_280px_320px]">

            <div class="pointer-events-none absolute inset-y-0 right-0 w-[128px] sm:w-[320px] rounded-[28px] border-[1.5px] border-purple" aria-hidden="true"></div>

            <div class="col-start-1 flex h-[56px] lg:h-[62px] items-center pl-1 pt-[26px] box-content">
                <span class="font-sans font-[800] text-[12px] lg:text-[13px] tracking-[0.4px] text-gray dark:text-bg/70 transition-colors">{t('landlords.compare.colFeature')}</span>
            </div>
            <div class="col-start-2 flex h-[56px] lg:h-[62px] items-center justify-center px-3 pt-[26px] box-content">
                <span class="text-center font-sans font-bold text-[12px] lg:text-[14px] text-gray dark:text-bg/70 transition-colors">{t('landlords.compare.colOther')}</span>
            </div>
            <div class="col-start-3 flex h-[88px] w-[128px] sm:w-[320px] items-center justify-center rounded-t-[26px] bg-purple">
                <span class="text-center font-sans font-[800] text-[13px] lg:text-[16px] text-bg">{t('landlords.compare.colRf')}</span>
            </div>

            {rows.map((row, i) => (
                <>
                    <div class:list={['col-start-1 flex min-h-[56px] lg:min-h-[62px] items-center py-3 pr-3 pl-1 border-t border-black/8 dark:border-white/10 transition-colors', i === 0 ? '' : '']}>
                        <span class="font-sans font-medium text-[13px] lg:text-[15px] text-black dark:text-bg transition-colors">{row.label}</span>
                    </div>

                    <div class="col-start-2 flex min-h-[56px] lg:min-h-[62px] items-center justify-center px-3 border-t border-black/8 dark:border-white/10 transition-colors">
                        {row.other ? (
                            <span class="flex size-[30px] items-center justify-center rounded-full bg-black/7 dark:bg-white/12 transition-colors" title={t('landlords.compare.yes')}>
                                <svg class="size-[14px] text-gray dark:text-bg/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 13l4 4L19 7" />
                                </svg>
                                <span class="sr-only">{t('landlords.compare.yes')}</span>
                            </span>
                        ) : (
                            <span class="flex size-[30px] items-center justify-center rounded-full bg-black/5 dark:bg-white/8 transition-colors">
                                <span aria-hidden="true" class="h-[2px] w-[11px] rounded-full bg-black/30 dark:bg-white/40"></span>
                                <span class="sr-only">{t('landlords.compare.no')}</span>
                            </span>
                        )}
                    </div>

                    <div class:list={[
                        'col-start-3 flex min-h-[56px] lg:min-h-[62px] w-[128px] sm:w-[320px] items-center justify-center bg-purple/5 dark:bg-purple/12 border-t border-black/8 dark:border-white/10 transition-colors',
                        i === rows.length - 1 ? 'rounded-b-[26px]' : '',
                    ]}>
                        <span class="flex size-[30px] items-center justify-center rounded-full bg-purple">
                            <svg class="size-[14px] text-bg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 13l4 4L19 7" />
                            </svg>
                            <span class="sr-only">{t('landlords.compare.yes')}</span>
                        </span>
                    </div>
                </>
            ))}
        </div>
    </div>
</section>
