---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="olx-import" class="w-full scroll-mt-[72px] bg-bg dark:bg-black transition-colors duration-300 pt-5 pb-16 sm:pb-20 lg:pb-[100px] px-6 lg:px-[115px]">
    <div class="mx-auto max-w-[1209px]">

        <div class="rounded-[28px] bg-purple/13 px-6 py-10 sm:px-10 sm:py-12 lg:px-[60px] lg:py-[52px] transition-colors">
            <div class="flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-10">

                <div class="lg:max-w-[600px] lg:shrink-0">
                    <p class="flex items-center gap-[9px] font-sans text-[12px] font-bold text-purple-ink dark:text-purple-ink-dark">
                        <span aria-hidden="true" class="size-[6px] shrink-0 rounded-full bg-purple"></span>
                        {t('landlords.olx.eyebrow')}
                    </p>

                    <h2 class="mt-[18px] max-w-[560px] font-sans font-[800] text-[24px] sm:text-[28px] lg:text-[34px] leading-[1.2] tracking-[-0.9px] text-black dark:text-bg transition-colors">
                        {t('landlords.olx.title')}
                    </h2>

                    <p class="mt-3.5 max-w-[520px] font-sans text-[15px] lg:text-[16px] leading-[1.65] text-gray dark:text-bg/70 transition-colors">
                        {t('landlords.olx.text')}
                    </p>
                </div>

                <div class="w-full lg:max-w-[488px] flex flex-col gap-3.5">
                    <div class="flex items-center gap-2 rounded-[999px] bg-bg dark:bg-white/5 py-1.5 pl-4 pr-1.5 sm:pl-[22px] shadow-[0_8px_20px_0_rgba(0,0,0,0.1)] transition-colors">
                        <span
                            aria-hidden="true"
                            class="min-w-0 flex-1 select-none truncate font-sans text-[13px] sm:text-[14px] text-gray dark:text-bg/50 pointer-events-none transition-colors"
                        >
                            {t('landlords.olx.placeholder')}
                        </span>
                        <a
                            href="https://ogloszenia.rentfriends.app/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="shrink-0 whitespace-nowrap rounded-[999px] bg-[image:var(--background-image-gradient)] px-4 sm:px-5 py-3 font-sans text-[13px] sm:text-[14px] font-bold text-bg transition-all duration-300 ease-out hover:opacity-90 hover:scale-[1.02] active:scale-95 cursor-pointer"
                        >
                            {t('landlords.olx.button')}
                        </a>
                    </div>

                    <p class="pl-1.5 font-sans text-[12.5px] text-gray dark:text-bg/60 transition-colors">
                        {t('landlords.olx.hint')}
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
