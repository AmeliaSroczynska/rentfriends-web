---
import { Image, Picture } from 'astro:assets';
import phonesImg from '../assets/phones.png';
import logoImg from '../assets/logo.png';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="w-full bg-bg dark:bg-black font-sans pt-[10px] pb-[80px] overflow-visible transition-colors duration-300">
    <div class="w-full px-4 lg:px-[100px]">
        <div class="relative w-full rounded-[35px] bg-purple/20 dark:bg-purple/30 lg:h-[507px] flex flex-col md:flex-row items-center md:justify-center lg:justify-end px-6 py-10 md:px-10 lg:px-0 lg:py-0 overflow-visible gap-6 md:gap-10 lg:gap-0 transition-colors">

            <div class="lg:absolute lg:left-[68px] lg:-top-[64px] z-20 w-[50%] md:w-[45%] max-w-[140px] md:max-w-[280px] lg:max-w-[376px] lg:w-[376px] h-[220px] md:h-[400px] lg:h-[611px] mb-2 md:mb-0 flex-shrink-0 mx-auto lg:mx-0">
                <Picture src={phonesImg} formats={['avif']} fallbackFormat="webp" widths={[280, 376, 560, 752]} sizes="(min-width: 1024px) 376px, (min-width: 768px) 280px, 140px" loading="lazy" decoding="async" alt="Aplikacja RentFriends" pictureAttributes={{ class: 'contents' }} class="w-full h-full object-contain drop-shadow-2xl" />
            </div>

            <div class="w-full md:w-[55%] lg:w-[calc(100%-450px)] xl:w-[calc(100%-550px)] flex flex-col items-start z-20">
                <div class="flex items-center gap-3 mb-[24px] lg:mb-[32px]">
                    <div class="w-[40px] h-[40px] lg:w-[48px] lg:h-[48px] bg-white rounded-[12px] shadow-sm flex items-center justify-center p-1.5">
                        <Image src={logoImg} alt="" width={48} densities={[1, 2]} class="w-full h-full object-contain" />
                    </div>
                    <span class="text-black dark:text-bg text-[20px] lg:text-[24px] font-[700] tracking-tight transition-colors">RentFriends</span>
                </div>

                <h2 class="text-black dark:text-bg font-extrabold text-[32px] sm:text-[36px] lg:text-[38px] xl:text-[46px] leading-[1.1] tracking-[-1px] lg:tracking-[-1.44px] mb-[32px] lg:mb-[48px] whitespace-normal break-words transition-colors">
                    {t('cta.title')}
                </h2>

                <div class="flex flex-row flex-wrap items-center gap-3 w-full sm:w-auto">
                    <a href="https://play.google.com/store/apps/details?id=app.dyzury&pcampaignid=web_share" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 bg-black dark:bg-white/5 text-white px-5 py-1.5 rounded-[10px] border border-white/20 hover:opacity-90 hover:scale-[1.02] transition-all cursor-pointer h-[48px] lg:h-[44px] min-w-[145px] w-auto">
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M2.373 1.306C2.128 1.564 2 1.954 2 2.454v19.09c0 .5.128.89.373 1.148l.056.054 10.74-10.74v-.004L2.43 1.252l-.057.054z" fill="#4285F4"/>
                            <path d="M17.435 15.656l-4.266-4.266v-.004L2.43 1.252A1.666 1.666 0 0 1 3.5.75c.427 0 .85.148 1.228.406l12.707 7.228z" fill="#34A853"/>
                            <path d="M17.435 8.344l-4.266 4.266.002.002L2.43 23.35c.378.258.801.406 1.228.406a1.67 1.67 0 0 0 1.07-.502l12.707-7.228z" fill="#EA4335"/>
                            <path d="M17.435 15.656L22.65 12.7c1.135-.646 1.135-1.7 0-2.346l-5.215-2.956-4.266 4.266 4.266 4.266z" fill="#FBBC04"/>
                        </svg>
                        <div class="text-left flex flex-col justify-center">
                            <span class="block text-[9px] lg:text-[8px] font-medium tracking-wide uppercase text-white/90">{t('cta.googleplay')}</span>
                            <span class="block text-[16px] lg:text-[15px] font-semibold -mt-1 tracking-tight" style="font-family: 'Product Sans', sans-serif;">Google Play</span>
                        </div>
                    </a>

                    <a href="https://apps.apple.com/gr/app/rentfriends-rent-rooms/id6502833411" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 bg-black dark:bg-white/5 text-white px-5 py-1.5 rounded-[10px] border border-white/20 hover:opacity-90 hover:scale-[1.02] transition-all cursor-pointer h-[48px] lg:h-[44px] min-w-[145px] w-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-[20px] lg:w-[18px] h-auto" viewBox="0 0 14 17" fill="none">
                            <path d="M12.3713 14.5833C11.6797 15.6167 10.9463 16.625 9.82966 16.6417C8.71299 16.6667 8.35466 15.9833 7.08799 15.9833C5.81299 15.9833 5.42133 16.625 4.36299 16.6667C3.27133 16.7083 2.44633 15.5667 1.74633 14.5583C0.321325 12.5 -0.770342 8.70833 0.696325 6.15833C1.42132 4.89167 2.72132 4.09167 4.12966 4.06667C5.19632 4.05 6.21299 4.79167 6.87133 4.79167C7.52133 4.79167 8.75466 3.9 10.038 4.03333C10.5797 4.05833 12.0963 4.25 13.0713 5.68333C12.9963 5.73333 11.263 6.75 11.2797 8.85833C11.3047 11.375 13.488 12.2167 13.513 12.225C13.488 12.2833 13.163 13.425 12.363 14.5833M7.61299 1.25C8.22132 0.558333 9.22966 0.0333333 10.063 0C10.1713 0.975 9.77966 1.95833 9.19633 2.65833C8.62132 3.36667 7.67133 3.91667 6.73799 3.84167C6.61299 2.88333 7.07966 1.88333 7.61299 1.25Z" fill="white"/>
                        </svg>
                        <div class="text-left flex flex-col justify-center">
                            <span class="block text-[9px] lg:text-[8px] font-medium tracking-wide text-white/90">{t('cta.appstore')}</span>
                            <span class="block text-[17px] lg:text-[16px] font-semibold -mt-0.5 tracking-tight leading-none">App Store</span>
                        </div>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>