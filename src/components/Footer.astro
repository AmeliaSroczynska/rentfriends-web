---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEn = lang === 'en';

const landlordsBase = isEn ? '/en/landlords' : '/landlords';
const landlordLinks = [
    { href: landlordsBase, label: t('footer.landlords.overview') },
    { href: `${landlordsBase}#why`, label: t('footer.landlords.why') },
    { href: `${landlordsBase}#benefits`, label: t('footer.landlords.benefits') },
    { href: `${landlordsBase}#how-it-works`, label: t('footer.landlords.how') },
    { href: `${landlordsBase}#who-its-for`, label: t('footer.landlords.who') },
    { href: `${landlordsBase}#comparison`, label: t('footer.landlords.comparison') },
    { href: `${landlordsBase}#faq`, label: t('footer.landlords.faq') },
];
---

<footer class="w-full mt-0 bg-[image:var(--background-image-gradient)] text-white font-sans relative transition-colors duration-300">
    <div class="absolute top-0 left-0 w-full h-[50px] bg-bg dark:bg-black rounded-b-[35px] transition-colors duration-300"></div>

    <div class="w-full px-8 lg:px-[100px] pt-16 lg:pt-[100px]">

        <div class="flex flex-wrap w-full items-start gap-x-10 gap-y-12">

            <div class="flex-shrink-0 flex flex-col w-full lg:w-auto lg:flex-1 lg:max-w-[550px] min-w-[280px]">
                <div class="flex items-center gap-3">
                    <div class="w-[35px] h-[35px] bg-white rounded-[10px] shadow-sm flex items-center justify-center p-1">
                        <picture>
                        <source srcset="/logo.webp" type="image/webp" />
                        <img src="/logo.png" alt="RentFriends" width="35" height="35" decoding="async" loading="lazy" class="w-full h-full object-contain" />
                    </picture>
                    </div>
                    <span class="text-[16px] font-bold tracking-tight leading-none">RentFriends</span>
                </div>

                <p class="mt-[20px] text-[14px] font-normal leading-[1.5] max-w-[300px]" set:html={t('footer.description')}></p>

                <div class="mt-[27px] flex items-center gap-3">
                    <a href="https://www.facebook.com/rentfriendsapp" target="_blank" rel="noopener noreferrer" class="w-[36px] h-[36px] bg-white rounded-full flex items-center justify-center hover:opacity-90 transition-opacity">
                        <img src="/facebook.svg" alt="Facebook" class="w-3.5 h-3.5 object-contain" />
                    </a>
                    <a href="https://www.instagram.com/rentfriends.app?igsh=MWw3MWV4MzY0N3Bqag==" target="_blank" rel="noopener noreferrer" class="w-[36px] h-[36px] bg-white rounded-full flex items-center justify-center hover:opacity-90 transition-opacity">
                        <img src="/instagram.svg" alt="Instagram" class="w-4 h-4 object-contain" />
                    </a>
                    <a href="https://www.tiktok.com/@rentfriends.app?_r=1&_t=ZN-98H0NjQmnTC" target="_blank" rel="noopener noreferrer" class="w-[36px] h-[36px] bg-white rounded-full flex items-center justify-center hover:opacity-90 transition-opacity">
                        <img src="/tiktok.svg" alt="TikTok" class="w-4 h-4 object-contain" />
                    </a>
                </div>
            </div>

            <div class="flex flex-row flex-wrap gap-x-[40px] sm:gap-x-[90px] lg:gap-x-[130px] gap-y-10 min-w-0 lg:flex-shrink-0 lg:ml-auto lg:mr-[45px] xl:mr-[75px]">
                <div class="flex min-w-0 flex-col">
                    <h3 class="text-[14px] font-extrabold mb-[18px] tracking-wide leading-none">{t('footer.app')}</h3>
                    <ul class="flex flex-col gap-[18px]">
                        <li class="leading-none"><a href={isEn ? '/en/' : '/'} class="text-[14px] font-normal transition-opacity hover:underline">{t('nav.home')}</a></li>
                        <li class="leading-none"><a href={isEn ? '/en/#features' : '/#features'} class="text-[14px] font-normal transition-opacity hover:underline">{t('nav.features')}</a></li>
                        <li class="leading-none"><a href={isEn ? '/en/#reviews' : '/#reviews'} class="text-[14px] font-normal transition-opacity hover:underline">{t('nav.reviews')}</a></li>
                        <li class="leading-none"><a href={isEn ? '/en/#faq' : '/#faq'} class="text-[14px] font-normal transition-opacity hover:underline">{t('nav.faq')}</a></li>
                    </ul>
                </div>

                <div class="flex min-w-0 flex-col">
                    <h3 class="text-[14px] font-extrabold mb-[18px] tracking-wide leading-none">{t('footer.landlords')}</h3>
                    <ul class="flex flex-col gap-[18px]">
                        {landlordLinks.map((link) => (
                            <li class="leading-none">
                                <a href={link.href} class="text-[14px] font-normal transition-opacity hover:underline">{link.label}</a>
                            </li>
                        ))}
                    </ul>
                </div>

                <div class="flex min-w-0 flex-col">
                    <h3 class="text-[14px] font-extrabold mb-[18px] tracking-wide leading-none">{t('footer.legal')}</h3>
                    <ul class="flex flex-col gap-[18px]">
                        <li class="leading-none"><a href={isEn ? '/en/privacy-policy' : '/privacy-policy'} class="text-[14px] font-normal transition-opacity hover:underline">{t('footer.privacy')}</a></li>
                        <li class="leading-none"><a href={isEn ? '/en/terms-of-service' : '/terms-of-service'} class="text-[14px] font-normal transition-opacity hover:underline">{t('footer.terms')}</a></li>
                    </ul>
                </div>

            </div>
        </div>

        <div class="mt-[40px] lg:mt-[50px] w-full">
            <div class="w-full h-px bg-white/30"></div>
            <div class="pt-[30px] pb-[40px] flex justify-center items-center text-[14px] font-normal leading-none text-center flex-wrap gap-1">
                Made with
                <svg class="w-3.5 h-3.5 mx-0.5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
                by <a href="https://github.com/AmeliaSroczynska/rentfriends-web" target="_blank" rel="noopener noreferrer" class="hover:underline">RentFriends Team</a>
            </div>
        </div>

    </div>
</footer>