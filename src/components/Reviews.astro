---
import { Picture } from 'astro:assets';
import peopleImg from '../assets/people.png';
import people2Img from '../assets/people2.png';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const peopleWidths = [480, 800, 1200, 1740, 2400, 3480];
const peopleSizes = '(min-width: 1280px) 1740px, (min-width: 640px) calc(145vw - 116px), calc(145vw - 70px)';
const peopleQuality = 52;

const reviews = [
    { text: `"${t('reviews.1.text')}"`, author: "kisiel123" },
    { text: `"${t('reviews.2.text')}"`, author: "Małgorzata 12" },
    { text: `"${t('reviews.3.text')}"`, author: "VitQ 9" }
];

const allReviews = [reviews[reviews.length - 1], ...reviews, reviews[0]];
---

<section class="relative w-full overflow-x-clip pt-[40px] pb-[100px] lg:pb-[160px] bg-bg dark:bg-black transition-colors duration-300">
    <div class="w-full max-w-7xl mx-auto px-6 sm:px-10 mt-[15px] mb-[32px] select-none pointer-events-none">
        <div class="w-full flex justify-center">
            <Picture src={peopleImg} formats={['avif']} fallbackFormat="webp" widths={peopleWidths} sizes={peopleSizes} quality={peopleQuality} loading="lazy" decoding="async" alt="" pictureAttributes={{ class: 'contents' }} class="w-full h-auto max-h-[160px] lg:h-[200px] object-contain scale-145" />
        </div>
    </div>

    <div class="w-full px-6 sm:px-10 mx-auto max-w-5xl text-center relative z-10">
        <h2 class="text-[32px] sm:text-[45px] lg:text-[52px] font-extrabold tracking-tight mb-[22px]">
            <span class="text-black dark:text-bg transition-colors">{t('reviews.title.part1')}</span> <span class="text-transparent bg-clip-text bg-[image:var(--background-image-gradient)]">{t('reviews.title.part2')}</span>
        </h2>

        <div class="flex justify-center items-center gap-1.5 mb-[22px] text-amber-400">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>

        <div class="relative flex items-center justify-between max-w-4xl mx-auto mb-[16px] px-2 sm:px-16">
            <button id="prev-review" type="button" aria-label={t('reviews.prev')} class="absolute left-0 sm:left-2 w-10 h-10 sm:w-12 sm:h-12 rounded-full border border-gray/30 dark:border-white/20 bg-transparent flex items-center justify-center hover:bg-black/5 dark:hover:bg-white/10 transition-colors cursor-pointer z-20 top-[75px] sm:top-[65px] -translate-y-1/2">
                <svg class="w-5 h-5 text-black dark:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <div class="w-full overflow-hidden mx-auto">
                <div id="carousel-track" class="flex transition-transform duration-500 ease-in-out will-change-transform" style="transform: translateX(-100%);">
                    {allReviews.map((review) => (
                            <div class="w-full shrink-0 flex flex-col items-center justify-start select-none">
                                <div class="h-[150px] sm:h-[130px] flex items-center justify-center w-full px-4 sm:px-12 mb-[16px]">
                                    <p class="text-[16px] sm:text-[20px] text-gray dark:text-bg/80 font-sans font-medium leading-[1.4] transition-colors">{review.text}</p>
                                </div>
                                <h3 class="text-[28px] font-semibold text-black dark:text-white leading-none pb-2 transition-colors">{review.author}</h3>
                            </div>
                    ))}
                </div>
            </div>
            <button id="next-review" type="button" aria-label={t('reviews.next')} class="absolute right-0 sm:right-2 w-10 h-10 sm:w-12 sm:h-12 rounded-full border border-gray/30 dark:border-white/20 bg-transparent flex items-center justify-center hover:bg-black/5 dark:hover:bg-white/10 transition-colors cursor-pointer z-20 top-[75px] sm:top-[65px] -translate-y-1/2">
                <svg class="w-5 h-5 text-black dark:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </button>
        </div>

        <div class="flex justify-center items-center" id="review-dots">
            {reviews.map((_, index) => (
                    <button
                            type="button"
                            aria-label={`Go to review ${index + 1}`}
                            data-index={index + 1}
                            class="dot group flex size-7 items-center justify-center cursor-pointer"
                    >
                        <span class={`indicator h-2 rounded-full transition-all duration-300 ${index === 0 ? 'w-6 bg-[image:var(--background-image-gradient)]' : 'w-2 bg-gray/30 dark:bg-white/20 group-hover:bg-gray/50 dark:group-hover:bg-white/40'}`}></span>
                    </button>
            ))}
        </div>
    </div>

    <div class="w-full max-w-7xl mx-auto px-6 sm:px-10 mt-[40px] mb-[15px] select-none pointer-events-none">
        <div class="w-full flex justify-center ">
            <Picture src={people2Img} formats={['avif']} fallbackFormat="webp" widths={peopleWidths} sizes={peopleSizes} quality={peopleQuality} loading="lazy" decoding="async" alt="" pictureAttributes={{ class: 'contents' }} class="w-full h-auto max-h-[160px] lg:h-[200px] object-contain scale-145" />
        </div>
    </div>
</section>

<script>
    function initCarousel() {
        const track = document.getElementById('carousel-track') as HTMLElement;
        const dotsContainer = document.getElementById('review-dots') as HTMLElement;
        const prevBtn = document.getElementById('prev-review') as HTMLButtonElement;
        const nextBtn = document.getElementById('next-review') as HTMLButtonElement;

        if (!track || !dotsContainer || !prevBtn || !nextBtn) return;

        let currentIndex = 1;
        let isTransitioning = false;

        let touchStartX = 0;
        let touchEndX = 0;

        const dots = dotsContainer.querySelectorAll('.dot');
        const totalReviews = dots.length;

        function updateCarousel(smooth = true) {
            track.style.transition = smooth ? 'transform 0.5s ease-in-out' : 'none';
            track.style.transform = `translateX(-${currentIndex * 100}%)`;

            const activeDotIndex = currentIndex === 0
                ? totalReviews - 1
                : (currentIndex === totalReviews + 1 ? 0 : currentIndex - 1);

            dots.forEach((dot, i) => {
                const indicator = dot.querySelector('.indicator');
                if (!indicator) return;
                indicator.className = i === activeDotIndex
                    ? 'indicator w-6 h-2 rounded-full bg-[image:var(--background-image-gradient)] transition-all duration-300'
                    : 'indicator w-2 h-2 rounded-full bg-gray/30 dark:bg-white/20 group-hover:bg-gray/50 dark:group-hover:bg-white/40 transition-all duration-300';
            });
        }

        track.addEventListener('transitionend', () => {
            isTransitioning = false;
            if (currentIndex === 0) {
                currentIndex = totalReviews;
                updateCarousel(false);
            } else if (currentIndex === totalReviews + 1) {
                currentIndex = 1;
                updateCarousel(false);
            }
        });

        function goPrev() {
            if (isTransitioning) return;
            isTransitioning = true;
            currentIndex--;
            updateCarousel(true);
        }

        function goNext() {
            if (isTransitioning) return;
            isTransitioning = true;
            currentIndex++;
            updateCarousel(true);
        }

        prevBtn.addEventListener('click', goPrev);
        nextBtn.addEventListener('click', goNext);

        dots.forEach((dot) => {
            dot.addEventListener('click', (e) => {
                if (isTransitioning) return;
                const target = e.currentTarget as HTMLButtonElement;
                if (target.dataset.index) {
                    currentIndex = parseInt(target.dataset.index);
                    updateCarousel(true);
                }
            });
        });

        track.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        track.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
        }, { passive: true });

        function handleSwipe() {
            const swipeThreshold = 50;

            if (touchEndX < touchStartX - swipeThreshold) {
                goNext();
            } else if (touchEndX > touchStartX + swipeThreshold) {
                goPrev();
            }
        }
    }

    initCarousel();

    document.addEventListener('astro:page-load', initCarousel);
</script>