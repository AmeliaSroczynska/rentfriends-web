---
import { Image } from 'astro:assets';
import peopleImg from '../assets/people.png';
import people2Img from '../assets/people2.png';

const reviews = [
    { text: `"Super pomysł, tego właśnie brakowało – nikt nie lubi szukać mieszkania przez olx albo przez Facebooka."`, author: "kisiel123" },
    { text: `"Prowadzę kilka mieszkań na pokoje dla studentów i ta apka uratowała mi sporo telefonów typu „zmywarka nie działa”. Dodałam zadania w stylu „Wyczyszczenie filtra zmywarki” i... nagle działa 😉 Prosta, czytelna, szybkie checklisty. Naprawdę polecam."`, author: "Małgorzata 12" },
    { text: `"Świetny sposób na szybkie dzielenie obowiązków w mieszkaniu"`, author: "VitQ 9" }
];

const allReviews = [reviews[reviews.length - 1], ...reviews, reviews[0]];
---

<section class="relative w-full overflow-x-clip pt-[40px] pb-[100px] lg:pb-[160px] bg-bg">
    <div class="w-full max-w-7xl mx-auto px-6 sm:px-10 mt-[15px] mb-[32px] select-none pointer-events-none">
        <div class="w-full flex justify-center">
            <Image src={peopleImg} alt="" class="w-full h-auto max-h-[160px] lg:h-[200px] object-contain scale-145" />
        </div>
    </div>

    <div class="w-full px-6 sm:px-10 mx-auto max-w-5xl text-center relative z-10">
        <h2 class="text-[32px] sm:text-[45px] lg:text-[52px] font-extrabold tracking-tight mb-[22px]">
            <span class="text-black">Co mówią</span> <span class="text-transparent bg-clip-text bg-[image:var(--background-image-gradient)]">użytkownicy?</span>
        </h2>

        <div class="flex justify-center items-center gap-1.5 mb-[22px] text-amber-400">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>

        <div class="relative flex items-center justify-between max-w-4xl mx-auto mb-[16px] px-2 sm:px-16">
            <button id="prev-review" type="button" aria-label="Previous" class="absolute left-0 sm:left-2 w-10 h-10 sm:w-12 sm:h-12 rounded-full border border-gray/30 bg-transparent flex items-center justify-center hover:bg-black/5 transition-colors cursor-pointer z-20 top-[75px] sm:top-[65px] -translate-y-1/2">
                <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <div class="w-full overflow-hidden mx-auto">
                <div id="carousel-track" class="flex transition-transform duration-500 ease-in-out will-change-transform" style="transform: translateX(-100%);">
                    {allReviews.map((review) => (
                            <div class="w-full shrink-0 flex flex-col items-center justify-start">
                                <div class="h-[150px] sm:h-[130px] flex items-center justify-center w-full px-4 sm:px-12 mb-[16px]">
                                    <p class="text-[16px] sm:text-[20px] text-gray font-sans font-medium leading-[1.4]">{review.text}</p>
                                </div>
                                <h3 class="text-[28px] font-semibold text-black leading-none pb-2">{review.author}</h3>
                            </div>
                    ))}
                </div>
            </div>
            <button id="next-review" type="button" aria-label="Next" class="absolute right-0 sm:right-2 w-10 h-10 sm:w-12 sm:h-12 rounded-full border border-gray/30 bg-transparent flex items-center justify-center hover:bg-black/5 transition-colors cursor-pointer z-20 top-[75px] sm:top-[65px] -translate-y-1/2">
                <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </button>
        </div>

        <div class="flex justify-center items-center gap-2" id="review-dots">
            {reviews.map((_, index) => (
                    <button
                            type="button"
                            aria-label={`Go to review ${index + 1}`}
                            data-index={index + 1}
                            class={`dot h-2 rounded-full transition-all duration-300 cursor-pointer ${index === 0 ? 'w-6 bg-[image:var(--background-image-gradient)]' : 'w-2 bg-gray/30 hover:bg-gray/50'}`}
                    ></button>
            ))}
        </div>
    </div>

    <div class="w-full max-w-7xl mx-auto px-6 sm:px-10 mt-[40px] mb-[15px] select-none pointer-events-none">
        <div class="w-full flex justify-center ">
            <Image src={people2Img} alt="" class="w-full h-auto max-h-[160px] lg:h-[200px] object-contain scale-145" />
        </div>
    </div>
</section>

<script>
    let currentIndex = 1;
    let isTransitioning = false;

    const track = document.getElementById('carousel-track')!;
    const dotsContainer = document.getElementById('review-dots')!;
    const prevBtn = document.getElementById('prev-review')!;
    const nextBtn = document.getElementById('next-review')!;

    const dots = dotsContainer.querySelectorAll('.dot');
    const totalReviews = dots.length;

    function updateCarousel(smooth = true) {
        track.style.transition = smooth ? 'transform 0.5s ease-in-out' : 'none';
        track.style.transform = `translateX(-${currentIndex * 100}%)`;

        const activeDotIndex = currentIndex === 0
            ? totalReviews - 1
            : (currentIndex === totalReviews + 1 ? 0 : currentIndex - 1);

        dots.forEach((dot, i) => {
            dot.className = i === activeDotIndex
                ? 'dot w-6 h-2 rounded-full bg-[image:var(--background-image-gradient)] transition-all duration-300 cursor-pointer'
                : 'dot w-2 h-2 rounded-full bg-gray/30 hover:bg-gray/50 transition-all duration-300 cursor-pointer';
        });
    }

    track.addEventListener('transitionend', () => {
        isTransitioning = false;
        if (currentIndex === 0) {
            currentIndex = totalReviews;
            updateCarousel(false);
        } else if (currentIndex === totalReviews + 1) {
            currentIndex = 1;
            updateCarousel(false);
        }
    });

    prevBtn.addEventListener('click', () => {
        if (isTransitioning) return;
        isTransitioning = true;
        currentIndex--;
        updateCarousel(true);
    });

    nextBtn.addEventListener('click', () => {
        if (isTransitioning) return;
        isTransitioning = true;
        currentIndex++;
        updateCarousel(true);
    });

    dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
            if (isTransitioning) return;
            currentIndex = parseInt((e.currentTarget as HTMLButtonElement).dataset.index!);
            updateCarousel(true);
        });
    });
</script>