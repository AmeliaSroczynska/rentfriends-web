---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
    photos: string[];
    alt?: string;
}

const { photos, alt = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const preview = photos.slice(0, 3);
const extraCount = Math.max(0, photos.length - 3);
const count = photos.length;
---

{count > 0 && (
    <div
        class="photo-gallery"
        data-photo-gallery
        data-photos={JSON.stringify(photos)}
    >
        {count === 1 ? (
            <div class="bg-black/5 dark:bg-white/5">
                <button
                    type="button"
                    class="block w-full cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple"
                    data-gallery-open
                    data-index="0"
                    aria-label={t('share.listing.openGallery')}
                >
                    <img
                        src={photos[0]}
                        alt={alt}
                        loading="eager"
                        class="w-full h-[240px] sm:h-[320px] object-cover"
                    />
                </button>
            </div>
        ) : count === 2 ? (
            <div class="grid grid-cols-2 gap-1 bg-black/5 dark:bg-white/5">
                {photos.map((photo, index) => (
                    <button
                        type="button"
                        class="block w-full cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple"
                        data-gallery-open
                        data-index={String(index)}
                        aria-label={t('share.listing.openGallery')}
                    >
                        <img
                            src={photo}
                            alt={index === 0 ? alt : ''}
                            loading={index === 0 ? 'eager' : 'lazy'}
                            class="w-full h-[240px] sm:h-[320px] object-cover"
                        />
                    </button>
                ))}
            </div>
        ) : (
            <div class="grid grid-cols-2 grid-rows-2 gap-1 h-[240px] sm:h-[320px] bg-black/5 dark:bg-white/5">
                <button
                    type="button"
                    class="row-span-2 block w-full h-full min-h-0 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple"
                    data-gallery-open
                    data-index="0"
                    aria-label={t('share.listing.openGallery')}
                >
                    <img
                        src={preview[0]}
                        alt={alt}
                        loading="eager"
                        class="w-full h-full object-cover"
                    />
                </button>
                <button
                    type="button"
                    class="block w-full h-full min-h-0 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple"
                    data-gallery-open
                    data-index="1"
                    aria-label={t('share.listing.openGallery')}
                >
                    <img
                        src={preview[1]}
                        alt=""
                        loading="lazy"
                        class="w-full h-full object-cover"
                    />
                </button>
                <button
                    type="button"
                    class="relative block w-full h-full min-h-0 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple"
                    data-gallery-open
                    data-index="2"
                    aria-label={t('share.listing.openGallery')}
                >
                    <img
                        src={preview[2]}
                        alt=""
                        loading="lazy"
                        class="w-full h-full object-cover"
                    />
                    {extraCount > 0 && (
                        <span
                            class="absolute inset-0 flex items-center justify-center bg-black/55 text-white text-[28px] sm:text-[34px] font-extrabold tracking-tight"
                            aria-hidden="true"
                        >
                            +{extraCount}
                        </span>
                    )}
                </button>
            </div>
        )}

        <div
            class="photo-gallery-lightbox fixed inset-0 z-[200] hidden items-center justify-center bg-black/95"
            data-gallery-lightbox
            role="dialog"
            aria-modal="true"
            aria-label={t('share.listing.openGallery')}
            hidden
        >
            <button
                type="button"
                class="absolute top-4 right-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors cursor-pointer"
                data-gallery-close
                aria-label={t('share.listing.closeGallery')}
            >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18" />
                </svg>
            </button>

            <button
                type="button"
                class="absolute left-4 sm:left-7 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors cursor-pointer disabled:opacity-30"
                data-gallery-prev
                aria-label={t('share.listing.prevPhoto')}
            >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                    <path d="M14 6l-6 6 6 6" />
                </svg>
            </button>

            <figure class="flex max-h-full max-w-full flex-col items-center justify-center px-14 sm:px-20 py-16">
                <img
                    src={photos[0]}
                    alt=""
                    data-gallery-image
                    class="max-h-[min(80vh,900px)] max-w-full object-contain select-none"
                    draggable="false"
                />
                <figcaption
                    class="mt-4 text-[14px] font-semibold text-white/80 tabular-nums"
                    data-gallery-counter
                >
                    1 / {count}
                </figcaption>
            </figure>

            <button
                type="button"
                class="absolute right-4 sm:right-7 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors cursor-pointer disabled:opacity-30"
                data-gallery-next
                aria-label={t('share.listing.nextPhoto')}
            >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                    <path d="M10 6l6 6-6 6" />
                </svg>
            </button>
        </div>
    </div>
)}

<script>
    function initPhotoGalleries() {
        document.querySelectorAll<HTMLElement>('[data-photo-gallery]').forEach((root) => {
            if (root.dataset.galleryReady === '1') return;
            root.dataset.galleryReady = '1';

            const photos: string[] = JSON.parse(root.dataset.photos || '[]');
            if (!photos.length) return;

            const lightbox = root.querySelector<HTMLElement>('[data-gallery-lightbox]');
            const image = root.querySelector<HTMLImageElement>('[data-gallery-image]');
            const counter = root.querySelector<HTMLElement>('[data-gallery-counter]');
            const prevBtn = root.querySelector<HTMLButtonElement>('[data-gallery-prev]');
            const nextBtn = root.querySelector<HTMLButtonElement>('[data-gallery-next]');
            const closeBtn = root.querySelector<HTMLButtonElement>('[data-gallery-close]');
            if (!lightbox || !image || !counter || !prevBtn || !nextBtn || !closeBtn) return;

            // Avoid clipping by overflow:hidden ancestors on the listing card.
            document.body.appendChild(lightbox);

            let index = 0;
            let touchStartX = 0;

            const render = () => {
                image.src = photos[index];
                counter.textContent = `${index + 1} / ${photos.length}`;
                prevBtn.disabled = photos.length < 2;
                nextBtn.disabled = photos.length < 2;
            };

            const open = (startIndex: number) => {
                index = Math.max(0, Math.min(startIndex, photos.length - 1));
                render();
                lightbox.hidden = false;
                lightbox.classList.remove('hidden');
                lightbox.classList.add('flex');
                document.body.style.overflow = 'hidden';
                closeBtn.focus();
            };

            const close = () => {
                lightbox.hidden = true;
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
                document.body.style.overflow = '';
            };

            const step = (delta: number) => {
                index = (index + delta + photos.length) % photos.length;
                render();
            };

            root.querySelectorAll<HTMLElement>('[data-gallery-open]').forEach((btn) => {
                btn.addEventListener('click', () => {
                    open(Number(btn.dataset.index || '0'));
                });
            });

            closeBtn.addEventListener('click', close);
            prevBtn.addEventListener('click', () => step(-1));
            nextBtn.addEventListener('click', () => step(1));

            lightbox.addEventListener('click', (event) => {
                if (event.target === lightbox) close();
            });

            document.addEventListener('keydown', (event) => {
                if (lightbox.hidden) return;
                if (event.key === 'Escape') close();
                if (event.key === 'ArrowLeft') step(-1);
                if (event.key === 'ArrowRight') step(1);
            });

            lightbox.addEventListener(
                'touchstart',
                (event) => {
                    touchStartX = event.changedTouches[0]?.clientX ?? 0;
                },
                { passive: true },
            );

            lightbox.addEventListener(
                'touchend',
                (event) => {
                    const endX = event.changedTouches[0]?.clientX ?? 0;
                    const delta = endX - touchStartX;
                    if (Math.abs(delta) < 50) return;
                    step(delta < 0 ? 1 : -1);
                },
                { passive: true },
            );
        });
    }

    initPhotoGalleries();
    document.addEventListener('astro:page-load', initPhotoGalleries);
</script>
