---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import {
    formatDate,
    formatPriceRange,
    listingPhotos,
    locationLabel,
    type PublicListing,
} from '../../lib/publicApi';
import StoreButtons from './StoreButtons.astro';
import OpenInAppButton from './OpenInAppButton.astro';

interface Props {
    listing: PublicListing;
    showOwnerLink?: boolean;
}

const { listing, showOwnerLink = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const photos = listingPhotos(listing);
const price = formatPriceRange(listing, t('share.listing.perMonth'));
const location = locationLabel(listing);
const landlordHref = listing.owner_share_uuid
    ? localizePath(`/w/${listing.owner_share_uuid}`, lang)
    : null;

const roomTypeLabel = (roomType: string | null) => {
    if (!roomType) return null;
    const key = `share.roomType.${roomType}` as Parameters<typeof t>[0];
    const label = t(key);
    return label === undefined ? roomType : label;
};
---

<article class="w-full max-w-[760px] mx-auto">
    <div class="rounded-[28px] overflow-hidden bg-white dark:bg-white/5 shadow-[0_20px_60px_rgba(0,0,0,0.12)] border border-black/5 dark:border-white/10">
        {photos.length > 0 ? (
            <div class="grid grid-cols-2 gap-1 bg-black/5 dark:bg-white/5">
                <img
                    src={photos[0]}
                    alt={location}
                    loading="eager"
                    class={`w-full h-[240px] sm:h-[320px] object-cover ${photos.length === 1 ? 'col-span-2' : ''}`}
                />
                {photos.slice(1, 3).map((photo, index) => (
                    <img
                        src={photo}
                        alt=""
                        loading="lazy"
                        class={`w-full object-cover ${photos.length === 2 ? 'h-[240px] sm:h-[320px]' : 'h-[118px] sm:h-[158px]'} ${photos.length > 2 && index === 0 ? 'col-start-2' : ''}`}
                    />
                ))}
            </div>
        ) : (
            <div class="w-full h-[240px] sm:h-[320px] flex items-center justify-center bg-[linear-gradient(135deg,#2d3d8a,#8654d9)] text-white text-[18px] font-semibold">
                {t('share.listing.noPhoto')}
            </div>
        )}

        <div class="p-6 sm:p-8">
            <p class="text-[13px] font-semibold uppercase tracking-wide text-gray dark:text-white/60">
                {location || '—'}
            </p>

            {price && (
                <p class="mt-2 text-[30px] sm:text-[36px] font-extrabold leading-none tracking-tight text-black dark:text-white">
                    {price}
                </p>
            )}

            {listing.occupants_count > 0 && (
                <p class="mt-3 text-[15px] text-gray dark:text-white/70">
                    {t('share.listing.occupants')}: {listing.occupants_count}
                </p>
            )}

            {listing.bio && (
                <p class="mt-5 text-[16px] leading-relaxed text-black/80 dark:text-white/80 whitespace-pre-line">
                    {listing.bio}
                </p>
            )}

            {listing.rooms.length > 0 && (
                <section class="mt-7">
                    <h2 class="text-[13px] font-semibold uppercase tracking-wide text-gray dark:text-white/60 mb-3">
                        {t('share.listing.rooms')}
                    </h2>
                    <ul class="flex flex-col gap-3">
                        {listing.rooms.map((room) => (
                            <li class="rounded-[16px] bg-black/[0.04] dark:bg-white/[0.06] px-4 py-3">
                                <div class="flex items-baseline justify-between gap-4">
                                    <strong class="text-[16px] text-black dark:text-white">{room.label}</strong>
                                    {Number(room.price) > 0 && (
                                        <span class="text-[16px] font-bold whitespace-nowrap text-black dark:text-white">
                                            {Number(room.price)} {t('share.listing.perMonth')}
                                        </span>
                                    )}
                                </div>
                                <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] text-gray dark:text-white/70">
                                    {roomTypeLabel(room.room_type) && <span>{roomTypeLabel(room.room_type)}</span>}
                                    {formatDate(room.available_from, lang) && (
                                        <span>{t('share.listing.availableFrom')} {formatDate(room.available_from, lang)}</span>
                                    )}
                                </div>
                            </li>
                        ))}
                    </ul>
                </section>
            )}

            {listing.owner_name && (
                <section class="mt-7 flex items-center gap-3 rounded-[16px] bg-black/[0.04] dark:bg-white/[0.06] p-4">
                    {listing.owner_photo ? (
                        <img src={listing.owner_photo} alt="" loading="lazy" class="w-11 h-11 rounded-full object-cover" />
                    ) : (
                        <div class="w-11 h-11 rounded-full bg-purple/20 flex items-center justify-center text-[18px] font-bold text-black dark:text-white">
                            {listing.owner_name.charAt(0)}
                        </div>
                    )}
                    <div class="flex-1 min-w-0">
                        <p class="text-[11px] font-semibold uppercase tracking-wide text-gray dark:text-white/60">
                            {t('share.listing.listedBy')}
                        </p>
                        <strong class="text-[15px] text-black dark:text-white">{listing.owner_name}</strong>
                    </div>
                    {showOwnerLink && landlordHref && (
                        <a href={landlordHref} class="shrink-0 text-[13px] font-semibold text-purple hover:opacity-80 transition-opacity">
                            {t('share.listing.otherListings')}
                        </a>
                    )}
                </section>
            )}

            <section class="mt-8 pt-7 border-t border-black/10 dark:border-white/10">
                <div class="mb-4">
                    <OpenInAppButton />
                </div>
                <p class="text-[15px] text-gray dark:text-white/70 mb-4">{t('share.storesLead')}</p>
                <StoreButtons />
            </section>
        </div>
    </div>
</article>
