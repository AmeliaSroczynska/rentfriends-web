---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="max-w-[640px] mx-auto text-center py-10">
    <h1 class="text-[34px] sm:text-[42px] font-extrabold leading-[1.1] tracking-tight mb-6">
        <span class="text-black dark:text-white">{t('page404.heading.part1')}</span><span class="bg-[linear-gradient(100deg,#234CE0_6.17%,#A247E3_50%,#E95BD2_93.83%)] text-transparent bg-clip-text pb-2 box-decoration-clone">{t('page404.heading.part2')}</span>
    </h1>

    <p class="text-[15px] sm:text-[17.5px] text-gray dark:text-white/80 mb-8 leading-relaxed">
        {t('page404.paragraph')}
    </p>

    <a
        href={lang === 'en' ? '/en' : '/'}
        class="inline-flex items-center justify-center px-8 sm:px-20 py-2.5 sm:py-3 bg-purple text-white text-[16px] font-semibold rounded-full hover:opacity-90 hover:scale-[1.02] active:scale-95 transition-all duration-300 ease-out"
    >
        {t('page404.button')}
    </a>
</div>
