---
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import { getLangFromUrl, getAlternateLinks } from '../i18n/utils';
import CookieBanner from '../components/CookieBanner.astro';
import { heroImage, heroWidths, heroSizes, heroFormat } from '../data/heroImage';

export interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	preloadHero?: boolean;
}

const {
	title = "RentFriends (Rent Friends) - Inteligentna platforma dopasowywania współlokatorów",
	description = "RentFriends pomaga znaleźć idealnego współlokatora i opanować domowe obowiązki bez stresu. Sprawdź naszą aplikację!",
	image = "/og-image.jpg",
	noindex = false,
	preloadHero = false
} = Astro.props;

const heroPreload = preloadHero
	? await getImage({
		src: heroImage,
		widths: heroWidths,
		format: heroFormat,
		layout: 'constrained',
		fit: 'cover',
		position: 'center'
	})
	: null;

const lang = getLangFromUrl(Astro.url);

const siteURL = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const socialImageURL = new URL(image, siteURL);
const alternateLinks = noindex ? [] : getAlternateLinks(Astro.url, siteURL);

const brandSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${canonicalURL}#website`,
			"url": canonicalURL.toString(),
			"name": "RentFriends",
			"alternateName": [
				"Rent Friends",
				"RentFriends.app"
			]
		},
		{
			"@type": "Organization",
			"@id": `${canonicalURL}#organization`,
			"name": "RentFriends",
			"alternateName": [
				"Rent Friends",
				"RentFriends.app"
			],
			"url": canonicalURL.toString(),
			"logo": new URL("/logo.png", Astro.site ?? Astro.url).toString(),
			"sameAs": [
				"https://www.facebook.com/rentfriendsapp",
				"https://www.instagram.com/rentfriends.app",
				"https://www.tiktok.com/@rentfriends.app",
				"https://play.google.com/store/apps/details?id=app.dyzury",
				"https://apps.apple.com/gr/app/rentfriends-rent-rooms/id6502833411"
			]
		}
	]
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />

	<!-- Google Tag Manager -->
	<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
	new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
	j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
	'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
	})(window,document,'script','dataLayer','GTM-W39KGBF4');</script>
	<!-- End Google Tag Manager -->

	{heroPreload && (
		<link
			rel="preload"
			as="image"
			type={`image/${heroFormat}`}
			imagesrcset={heroPreload.srcSet.attribute}
			imagesizes={heroSizes}
			fetchpriority="high"
		/>
	)}
	<link rel="icon" href="/favicon.ico" sizes="32x32" />
	<link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
	<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
	<meta name="generator" content={Astro.generator} />
	<meta name="theme-color" content="#A247E3" />

	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={canonicalURL} />
	{noindex && <meta name="robots" content="noindex, follow" />}

	{alternateLinks.map((alt) => (
		<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
	))}

	<meta property="og:site_name" content="RentFriends" />
	<meta property="og:type" content="website" />
	<meta property="og:url" content={canonicalURL} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={socialImageURL} />
	<meta property="og:image:width" content="1201" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:type" content="image/jpeg" />
	<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'pl_PL'} />
	{!noindex && <meta property="og:locale:alternate" content={lang === 'en' ? 'pl_PL' : 'en_US'} />}

	<meta property="twitter:card" content="summary_large_image" />
	<meta property="twitter:url" content={canonicalURL} />
	<meta property="twitter:title" content={title} />
	<meta property="twitter:description" content={description} />
	<meta property="twitter:image" content={socialImageURL} />

	<Font
		cssVariable="--font-plus-jakarta"
		preload={[
			{ weight: 400, subset: 'latin' },
			{ weight: 400, subset: 'latin-ext' },
			{ weight: 800, subset: 'latin' },
			{ weight: 800, subset: 'latin-ext' }
		]}
	/>

	<meta name="apple-itunes-app" content="app-id=6502833411">

	<script type="application/ld+json" set:html={JSON.stringify(brandSchema)} />

	<script is:inline>
		const setDarkMode = () => {
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		};

		setDarkMode();
		document.addEventListener('astro:after-swap', setDarkMode);
	</script>

	<script is:inline>
		(() => {
			let counterLoaded = false;

			const loadCounter = () => {
				if (counterLoaded) return;
				counterLoaded = true;
				const s = document.createElement('script');
				s.src = 'https://cdn.counter.dev/script.js';
				s.dataset.id = 'e8ae0803-d06f-4542-bab6-fec00026bafa';
				s.dataset.utcoffset = '2';
				document.head.appendChild(s);
			};

			const hasAnalyticsConsent = () => {
				try {
					const raw = localStorage.getItem('rf-cookie-consent');
					if (!raw) return false;
					const parsed = JSON.parse(raw);
					return Boolean(parsed && parsed.version === 1 && parsed.analytics);
				} catch (error) {
					return false;
				}
			};

			const maybeLoadCounter = () => {
				if (hasAnalyticsConsent()) loadCounter();
			};

			document.addEventListener('rf:cookie-consent', maybeLoadCounter);

			if (document.readyState === 'complete') {
				maybeLoadCounter();
			} else {
				window.addEventListener('load', maybeLoadCounter, { once: true });
			}
		})();
	</script>
</head>
<body class="bg-bg text-black dark:bg-black dark:text-bg font-sans antialiased min-h-screen transition-colors duration-300">
	<!-- Google Tag Manager (noscript) -->
	<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W39KGBF4"
	height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
	<!-- End Google Tag Manager (noscript) -->
<slot />
<CookieBanner />
</body>
</html>