---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`RentFriends | ${t('terms.title')}`}>
    <Navbar />

    <main class="w-full bg-bg dark:bg-black font-sans pt-[120px] pb-[100px] px-6 lg:px-[100px] transition-colors duration-300">

        <div class="max-w-4xl mx-auto">

            <header class="mb-12">
                <h1 class="text-4xl md:text-5xl font-black tracking-tighter mb-4 text-transparent bg-clip-text bg-gradient pb-1 leading-tight">
                    {t('terms.title')}
                </h1>
                <p class="text-base text-gray dark:text-white/80 font-medium transition-colors">
                    {t('terms.effective')} <span class="text-black dark:text-white font-bold">{t('terms.date')}</span>
                </p>
            </header>

            <hr class="border-gray/30 dark:border-white/15 mb-10 transition-colors" />

            <div class="space-y-12">

                <section>
                    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-black dark:text-white mb-4 transition-colors">{t('terms.s1.title')}</h2>
                    <div class="pl-4 md:pl-6 text-base text-gray dark:text-white/80 leading-relaxed transition-colors">
                        <p class="mb-3">{t('terms.s1.p1')}</p>
                        <ul class="list-disc marker:text-blue pl-6 space-y-1.5 mb-4" set:html={t('terms.s1.l1')}></ul>
                        <p class="mb-3">{t('terms.s1.p2')}</p>
                        <p class="mt-4 p-3 bg-white/50 dark:bg-white/5 rounded-xl inline-block border border-gray/20 dark:border-white/15 text-sm md:text-base transition-colors" set:html={t('terms.s1.contact')}></p>
                    </div>
                </section>

                <hr class="border-gray/20 dark:border-white/15 transition-colors" />

                <section>
                    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-black dark:text-white mb-4 transition-colors">{t('terms.s2.title')}</h2>
                    <div class="pl-4 md:pl-6 text-base text-gray dark:text-white/80 leading-relaxed transition-colors">
                        <p class="mb-3">{t('terms.s2.p1')}</p>
                        <p class="mb-3">{t('terms.s2.p2')}</p>
                        <p class="mb-3">{t('terms.s2.p3')}</p>
                        <ul class="list-disc marker:text-blue pl-6 space-y-1.5" set:html={t('terms.s2.l1')}></ul>
                    </div>
                </section>

                <hr class="border-gray/20 dark:border-white/15 transition-colors" />

                <section>
                    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-black dark:text-white mb-4 transition-colors">{t('terms.s3.title')}</h2>
                    <div class="pl-4 md:pl-6 text-base text-gray dark:text-white/80 leading-relaxed transition-colors">
                        <p class="mb-3">{t('terms.s3.p1')}</p>
                        <ul class="list-disc marker:text-blue pl-6 space-y-1.5 mb-4" set:html={t('terms.s3.l1')}></ul>
                        <p>{t('terms.s3.p2')}</p>
                    </div>
                </section>

                <hr class="border-gray/20 dark:border-white/15 transition-colors" />

