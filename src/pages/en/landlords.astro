---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import LandlordsHero from '../../components/landlords/LandlordsHero.astro';
import LandlordsWhy from '../../components/landlords/LandlordsWhy.astro';
import LandlordsGain from '../../components/landlords/LandlordsGain.astro';
import LandlordsHow from '../../components/landlords/LandlordsHow.astro';
import LandlordsOlx from '../../components/landlords/LandlordsOlx.astro';
---

<Layout title="RentFriends - For landlords">
    <Navbar variant="landlords" />

    <main class="min-h-[calc(100vh-72px)] flex flex-col">
        <LandlordsHero />
        <LandlordsWhy />
        <LandlordsGain />

        <div id="how-it-works" class="scroll-mt-[72px]">
            <LandlordsHow />
        </div>

        <LandlordsOlx />
    </main>

    <Footer />
</Layout>
