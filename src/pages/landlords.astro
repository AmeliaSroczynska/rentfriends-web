---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LandlordsHero from '../components/landlords/LandlordsHero.astro';
import LandlordsWhy from '../components/landlords/LandlordsWhy.astro';
import LandlordsGain from '../components/landlords/LandlordsGain.astro';
import LandlordsFeatures from '../components/landlords/LandlordsFeatures.astro';
import LandlordsHow from '../components/landlords/LandlordsHow.astro';
import LandlordsOlx from '../components/landlords/LandlordsOlx.astro';
import LandlordsMeet from '../components/landlords/LandlordsMeet.astro';
import LandlordsWho from '../components/landlords/LandlordsWho.astro';
import LandlordsMission from '../components/landlords/LandlordsMission.astro';
import LandlordsCompare from '../components/landlords/LandlordsCompare.astro';
import LandlordsFAQ from '../components/landlords/LandlordsFAQ.astro';
import LandlordsCTA from '../components/landlords/LandlordsCTA.astro';
---

<Layout title="RentFriends - Dla właścicieli mieszkań">
    <Navbar variant="landlords" />

    <main class="min-h-[calc(100vh-72px)] flex flex-col">
        <LandlordsHero />
        <LandlordsWhy />
        <LandlordsFeatures />
        <LandlordsGain />

        <LandlordsHow />
        <LandlordsOlx />
        <LandlordsMeet />
        <LandlordsWho />
        <LandlordsMission />
        <LandlordsCompare />
        <LandlordsFAQ />
        <LandlordsCTA />
    </main>

    <Footer />
</Layout>
